{
  "name": "kr-subdivision-tracker",
  "private": true,
  "version": "1.0.12",
  "description": "KR Surveys Subdivision Tracker — monorepo (web, api, worker, shared packages).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "lint": "pnpm -r lint && node scripts/ci/check-ci-matrix.mjs && node scripts/plan/check-work-packages.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:contract": "pnpm -r test:contract",
    "test:infra": "node --test infra/railway/ infra/clamav/test/*.mjs infra/test/*.mjs",
    "test:e2e": "pnpm --filter @kr/web test:e2e",
    "test:mutation": "pnpm -r test:mutation",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm test:contract",
    "dev": "pnpm -r --parallel --if-present dev",
    "db:up": "docker compose up -d postgres s3 clamav",
    "db:down": "docker compose down",
    "openapi:generate": "pnpm --filter @kr/contracts openapi:generate",
    "openapi:check": "pnpm --filter @kr/contracts openapi:check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "lefthook": "2.2.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
