{
  "name": "@kr/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Object storage (S3-compatible / Railway Buckets) adapter, in-memory fake, and content-type sniffing for uploads.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@kr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit --passWithNoTests",
    "test:integration": "vitest run --project integration --coverage --coverage.reportsDirectory=coverage/integration --passWithNoTests",
    "test:contract": "echo 'no contract layer in this package'",
    "test:e2e": "echo 'no e2e layer in this package'",
    "test:mutation": "stryker run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/lib-storage": "3.1147.0",
    "@kr/workflow": "workspace:*",
    "file-type": "22.1.1"
  },
  "devDependencies": {
    "testcontainers": "12.2.0"
  }
}
