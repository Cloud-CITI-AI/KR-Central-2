{
  "$schema": "../service.schema.json",
  "service": "worker",
  "image": "worker",
  "startCommand": "node dist/main.js",
  "healthcheck": { "path": "/healthz", "timeoutSeconds": 60 },
  "restartPolicy": { "type": "ON_FAILURE", "maxRetries": 10 },
  "cronSchedule": null,
  "replicas": 1,
  "sleepApplication": false
}
