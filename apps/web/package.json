{
  "name": "@kr/web",
  "version": "0.0.0",
  "private": true,
  "description": "KR Subdivision Tracker web front end (Next.js App Router) and thin same-origin API proxy (BFF).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test:unit": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "echo 'no integration layer in this package'",
    "test:contract": "echo 'no contract layer in this package'",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:mutation": "stryker run",
    "perf:check": "size-limit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@kr/contracts": "workspace:*",
    "@kr/design-tokens": "workspace:*",
    "@kr/workflow": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@faker-js/faker": "10.6.0",
    "@kr/db": "workspace:*",
    "@kr/mock-idp": "workspace:*",
    "@playwright/test": "1.64.0",
    "@size-limit/file": "14.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "oidc-provider": "9.12.2",
    "pdf-lib": "1.17.1",
    "size-limit": "14.2.0"
  }
}
