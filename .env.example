# Every variable used by the services, with FAKE values (playbook CF-3). Copy to .env for local development.
# Never commit real values. In Railway, set these as service variables (sealed for secrets) — see docs/runbooks/deploy-railway.md.

# ---------------------------------------------------------------- shared
NODE_ENV=development
APP_ENV=local                      # local | preview | staging | production
LOG_LEVEL=debug
RELEASE_VERSION=dev

# ---------------------------------------------------------------- services/api
PORT=8080
TRUST_PROXY_HOPS=2
DATABASE_URL=postgres://tracker_app:local-app-password@localhost:5432/tracker      # tracker_app role (DML only)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
PUBLIC_BASE_URL=http://localhost:3000                                              # web origin; https outside local
ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000001                               # KR Surveys directory (tenant) ID
ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000002                               # app registration (client) ID
ENTRA_CLIENT_SECRET=fake-client-secret-change-me                                   # app registration client secret (rotate ≤ 90 days)
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
KR_STAFF_EMAIL_DOMAINS=krsurveys.com.au
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOG_PSEUDONYM_SALT=fake-log-salt-change-me
REQUIRE_MFA_FOR_ADMIN=false                                                        # true in staging/production
S3_ENDPOINT=http://localhost:9090                                                  # Railway Bucket endpoint in cloud
S3_REGION=auto
S3_BUCKET=tracker-files-local
S3_ACCESS_KEY_ID=fake-access-key
S3_SECRET_ACCESS_KEY=fake-secret-access-key
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=52428800
MALWARE_SCAN_MODE=disabled                                                         # required outside local
FEATURE_AI_STAMP_READING=false
FEATURE_ENTRA_GUEST_INVITES=false
OTEL_EXPORTER_OTLP_ENDPOINT=                                                       # empty = no export (X7 approval needed)
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------------------------------------------------------- services/worker (plus DATABASE_*, S3_*, MALWARE_SCAN_MODE, FEATURE_AI_STAMP_READING above)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=                                                                 # only when FEATURE_AI_STAMP_READING=true
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_MS=30000
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300
PDF_MAX_PAGES=60

# ---------------------------------------------------------------- apps/web
API_INTERNAL_URL=http://localhost:8080                                             # Railway: http://api.railway.internal:8080

# ---------------------------------------------------------------- packages/db CLIs (operators / deploy job only)
MIGRATION_DATABASE_URL=postgres://tracker_migrator:local-migrator-password@localhost:5432/tracker
SUPERUSER_DATABASE_URL=postgres://postgres:local-superuser-password@localhost:5432/tracker
TRACKER_MIGRATOR_PASSWORD=local-migrator-password
TRACKER_APP_PASSWORD=local-app-password

# ---------------------------------------------------------------- tests without Docker (optional)
TEST_DATABASE_ADMIN_URL=
