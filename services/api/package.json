{
  "name": "@kr/api",
  "version": "0.0.0",
  "private": true,
  "description": "KR Subdivision Tracker HTTP API (Fastify; modules with http -> domain -> data layering).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@kr/source src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0 && node ../../scripts/check-module-boundaries.mjs src/modules",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit --passWithNoTests",
    "test:integration": "vitest run --project integration --coverage --coverage.reportsDirectory=coverage/integration --passWithNoTests",
    "test:contract": "vitest run --project contract --coverage --coverage.reportsDirectory=coverage/contract --passWithNoTests",
    "test:e2e": "echo 'service e2e runs in deploy smoke tests' && exit 0",
    "test:mutation": "stryker run",
    "test:load": "k6 run load/smoke.js",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@kr/config": "workspace:*",
    "@kr/contracts": "workspace:*",
    "@kr/db": "workspace:*",
    "@kr/logger": "workspace:*",
    "@kr/storage": "workspace:*",
    "@kr/telemetry": "workspace:*",
    "@kr/workflow": "workspace:*",
    "@openfeature/server-sdk": "1.23.0",
    "archiver": "8.0.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.6",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@kr/mock-idp": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/archiver": "8.0.0",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oidc-provider": "9.12.2",
    "pdf-lib": "1.17.1",
    "testcontainers": "12.2.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
